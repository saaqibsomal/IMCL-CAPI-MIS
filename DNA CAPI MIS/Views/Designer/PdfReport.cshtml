                $("#PdfGen").click(function () {
                    $("#pdfModel").css("display", "block");
                });

                $(".close").click(function () {
                    $("#pdfModel").css("display", "none");
                });

                $(window).click(function (event) {
                    if (event.target == $("#pdfModel")[0]) {
                        $("#pdfModel").css("display", "none");
                    }
                });

                $("#downloadPDFBtn").click(function () {
                    generatePDF();
                });
            });
</script>
<script>
        $(document).ready(function () {


            $.ajax({
            type: 'POST',
            url: "/Designer/CreatePDFBySurvey/" + 0,
            data: {},
            success: function (data) {

                $('#tbody').empty();
                 var tbody = $('#tbody');
                    $.each(data, function(index, item) {
                        var row = $('<tr></tr>');
                         row.append('<td><a href="#" onclick="OpenReport(' + item.sbjnum + ')"> Print </a></td>');
                        row.append('<td>' + item.Created + '</td>');
                        row.append('<td>' + item.SurveyorName + '</td>');

                         row.click(function() {
                            // Call your function here, passing the subject number as a parameter
                            OpenReport(item.sbjnum);
                        });

                        tbody.append(row);
                    });
            }
        });

        });
        //$("#Checklist").find('option:selected').text()
        function OpenReport(sbjnum)
        {
            var Pro;
            if ($("#Checklist").find('option:selected').text().includes("-")) {
                Pro = $("#Checklist").find('option:selected').text().split('-')[1];
            } else {
                Pro = $("#Checklist").find('option:selected').text();
            }
             $.ajax({
            type: 'POST',
            url: "/Designer/OpenReport/" + sbjnum,
            data: {},
            success: function (data) {

                $("#Heading").text("Monitoring Visit Report ("  + Pro + ")");
                $("#SubHeading").text("(For "+ Pro + ")");
                $("#NameOfDistrict").text(data.Field.NameOfDistrict);
                $("#NameOfCenter").text(data.Field.NameOfCenter);
                $("#DateOfVisit").text(data.Field.DateOfVisit);
                $("#TimeOfVisit").text(data.Field.TimeOfVisit);
                $("#OpenCloseStatus").text(data.Field.OpenCloseStatus);
                
                
                //var index = findIndexByTitle(data.DataTitle,"Name of Distirict");

                  $("#pdfModel").css("display", "block");

            }
        });
        }

    function generatePDF() {
    // Create a new jsPDF instance
    var doc = new jsPDF();

    // HTML content to be converted to PDF
    var htmlContent = document.getElementById('content').innerHTML;

    // Convert HTML to PDF
    doc.html(htmlContent, {
        callback: function (doc) {
            // Save the PDF
            doc.save('output.pdf');
        }
    });
}
        function generatePDF1() {

    var htmlContent = document.getElementById('pdfModel').innerHTML;
    $.ajax({
        type: 'POST',
        url: '/Designer/GeneratePDF/'+htmlContent,
        //data: { htmlContent: htmlContent },
        success: function (response) {
            // Download the generated PDF
            var blob = new Blob([response], { type: 'application/pdf' });
            var link = document.createElement('a');
            link.href = window.URL.createObjectURL(blob);
            link.download = 'output.pdf';
            link.click();
        },
        error: function (xhr, status, error) {
            console.error('Error generating PDF:', error);
        }
    });
}


